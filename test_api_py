def test_quiz(monkeypatch):

    fake_quiz = [
        {
            "question":
                "2 + 2 = ?",

            "options": [
                "1",
                "2",
                "3",
                "4"
            ],

            "correct_answer":
                "4",

            "explanation":
                "2 + 2 equals 4."
        }
    ]

    monkeypatch.setattr(
        main,
        "generate_quiz",
        lambda text:
            fake_quiz
    )

    response = client.post(
        "/quiz",
        json={
            "text":
                "Basic mathematics"
        }
    )

    assert response.status_code == 200

    assert (
        response.json()["quiz"]
        == fake_quiz
    )


